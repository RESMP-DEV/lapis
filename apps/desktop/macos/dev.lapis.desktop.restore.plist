<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The downloaded app's login item (Settings, "Keep agents running at login"):
     restarts agents whose services are gone and hosts them without a window
     until lapis opens. A developer build installs scripts/restore_at_login.py. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.lapis.desktop.restore</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/lapis</string>
	<key>ProgramArguments</key>
	<array>
		<string>lapis</string>
		<string>--restore-agents</string>
		<string>--serve</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
