root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.md]
# Markdown may intentionally use two trailing spaces for a hard line break.
trim_trailing_whitespace = false

[CMakePresets.json]
indent_size = 2
