{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 25, "patch": 0},
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "LAPIS_SANITIZER": "none",
        "LAPIS_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {"name": "dev", "inherits": "base", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}},
    {
      "name": "asan",
      "inherits": "dev",
      "cacheVariables": {"LAPIS_SANITIZER": "address"}
    },
    {
      "name": "tsan",
      "inherits": "dev",
      "cacheVariables": {"LAPIS_SANITIZER": "thread"}
    },
    {
      "name": "profile",
      "inherits": "base",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo"}
    },
    {"name": "desktop", "inherits": "profile", "cacheVariables": {"LAPIS_BUILD_DESKTOP": "ON"}}
  ],
  "buildPresets": [
    {"name": "dev", "configurePreset": "dev"},
    {"name": "asan", "configurePreset": "asan"},
    {"name": "tsan", "configurePreset": "tsan"},
    {"name": "profile", "configurePreset": "profile"},
    {"name": "desktop", "configurePreset": "desktop"}
  ],
  "testPresets": [
    {"name": "dev", "configurePreset": "dev", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "asan", "configurePreset": "asan", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "tsan", "configurePreset": "tsan", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "profile", "configurePreset": "profile", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "desktop", "configurePreset": "desktop", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}}
  ]
}
