      "areas": [
        "native/session/core/adapters and CMake",
        "remote Python and selectors",
        "Swift lifecycle and probe evidence"
      ],
      "disposition": "Fresh independent reviewers plus coordinator review. Repaired URI-only drop selection, CLI stale receipts, cached positive identity regression, thread-start admission failure, host cache collisions, equal-host invalidation, follow-up host guards and probe isolation. Final Swift recheck found only help text, which was corrected."
    }
  ],
  "repairs": [
    {
      "finding": "Q08",
      "change": "Keyboard and programmatic paste share IME reset, scoped ownership and post-reset destination checks. QML validates/quotes file URLs before selecting a tile and carries its destination ID through the deferred paste."
    },
    {
      "finding": "Q09",
      "change": "Takeover retires only the old client attachment's deferred history request before advancing identity; joined-view work remains owned.",
      "qualification": "Reviewed and ordinary takeover exercised; deterministic deferred-queue acceptance remains open."
    },
    {
      "finding": "Q11 partial",
      "change": "Production CMake targets directly declare terminal, attention, launch and platform dependencies. Internal include-tree export narrowing remains planned."
    },
    {
      "finding": "Workspace gateway ownership",
      "change": "Host generations guard all asynchronous mutations; same-host save preserves state. Complete-host digests separate disk caches. Preferences and cache are injected without production fixture environment flags."
    },
    {
      "finding": "Remote discovery bounds",
      "change": "Four concurrent SSH builds; 32 reports and 32 failures; 60-second failure retry. Four whois lookups and 256 cached verdicts; 300-second allowed/60-second denied TTL. Duplicates coalesce, cached allows stay allowed, failed thread start frees admission, malformed report objects are recorded as failures."
    },
    {
      "finding": "Verification efficiency and truthfulness",
      "change": "CLI lists/selects cases with inert discovery, prerequisites, deduplication, no empty success and actual-case receipts. Invalid jobs/selection cannot preserve a passing receipt. Foundation compile failures clean unique run artifacts and write failures; durable sanitized first-batch check records are preserved."
    }
  ],
  "compatibility_decision": {
    "finding": "Q06",
    "core": "Interactive v1 metadata 256 bytes and at most 16 choices",
    "wire": "Existing envelope 1024 bytes and 32 choices retained",
    "evidence": "Current Codex/Claude producers preflight the core limits; no reachable first-party over-core producer found. Future adapters must validate semantic admission; changing either limit requires explicit compatibility/UI/resource review."
  },
